{
  "nodes": [
    {
      "id": "file:demo/child_process.cpp",
      "type": "file",
      "name": "child_process.cpp",
      "filePath": "demo/child_process.cpp",
      "summary": "实现 demo 命名空间下的 fork/exec/wait 子进程工具函数，供 demo 程序拉起并管理 servicemanager、service、client 等子进程。子进程刻意继承 stdout/stderr，让服务端与客户端的 IPC 日志实时交织输出。",
      "tags": ["utility", "process-management", "fork-exec", "demo-harness"],
      "complexity": "simple",
      "languageNotes": "使用 POSIX 原语 fork/execl/waitpid/kill 直接管理进程；exec 失败时子进程以 127 退出，是 shell 约定的沿用。"
    },
    {
      "id": "file:demo/child_process.h",
      "type": "file",
      "name": "child_process.h",
      "filePath": "demo/child_process.h",
      "summary": "声明 demo 命名空间的子进程管理接口：spawn、stillAlive、waitForExit、terminate、execReplace，是 demo 侧进程编排的公共头文件。",
      "tags": ["type-definition", "process-management", "public-api", "header"],
      "complexity": "simple",
      "languageNotes": "使用 #pragma once 作为头文件保护，接口注释明确写清了返回值与副作用（如 terminate 会把 pid 置 -1，重复调用安全）。"
    },
    {
      "id": "file:examples/demo_service.cpp",
      "type": "file",
      "name": "demo_service.cpp",
      "filePath": "examples/demo_service.cpp",
      "summary": "示例 binder 服务进程：实现 IDemoService AIDL 接口（加法、回显、排序、回调注册与广播、传递 fd 的 openReport 等），通过 ProcessState 打开 /dev/binder 并以 \"demo.service\" 注册到 servicemanager，然后进入线程池处理事务。若系统中没有 servicemanager，会自行拉起一个，使该服务可独立运行。",
      "tags": ["entry-point", "binder-service", "aidl-implementation", "service", "ipc"],
      "complexity": "complex",
      "languageNotes": "完整演示了 binder 服务端的标准生命周期：ProcessState::self() 打开驱动并 mmap → defaultServiceManager() 拿到 handle 0 → addService 注册 → startThreadPool/joinThreadPool 处理事务；同时展示了 ParcelFileDescriptor 跨进程传递 fd 与 sp<> 强引用回调管理。"
    },
    {
      "id": "function:demo/child_process.cpp:spawn",
      "type": "function",
      "name": "spawn",
      "filePath": "demo/child_process.cpp",
      "lineRange": [12, 24],
      "summary": "fork 出子进程并 execl 指定可执行文件（不带参数），父进程返回子进程 pid，fork 失败返回 -1；exec 失败时子进程以 127 退出。",
      "tags": ["utility", "process-management", "fork-exec"],
      "complexity": "simple"
    },
    {
      "id": "function:demo/child_process.cpp:stillAlive",
      "type": "function",
      "name": "stillAlive",
      "filePath": "demo/child_process.cpp",
      "lineRange": [26, 29],
      "summary": "以 WNOHANG 方式 waitpid 判断子进程是否仍存活；若已退出则顺带回收，调用方不可再次 wait。",
      "tags": ["utility", "process-management", "health-check"],
      "complexity": "simple"
    },
    {
      "id": "function:demo/child_process.cpp:waitForExit",
      "type": "function",
      "name": "waitForExit",
      "filePath": "demo/child_process.cpp",
      "lineRange": [31, 35],
      "summary": "阻塞等待子进程结束并返回其退出码；若被信号杀死则返回 1。",
      "tags": ["utility", "process-management", "blocking"],
      "complexity": "simple"
    },
    {
      "id": "function:demo/child_process.cpp:terminate",
      "type": "function",
      "name": "terminate",
      "filePath": "demo/child_process.cpp",
      "lineRange": [37, 43],
      "summary": "向子进程发送 SIGTERM 并回收，随后把传入的 pid 引用置为 -1，因此重复调用是安全的。",
      "tags": ["utility", "process-management", "cleanup", "signal"],
      "complexity": "simple"
    },
    {
      "id": "function:demo/child_process.cpp:execReplace",
      "type": "function",
      "name": "execReplace",
      "filePath": "demo/child_process.cpp",
      "lineRange": [45, 49],
      "summary": "用指定可执行文件替换当前进程映像，仅在 exec 失败时返回 127。",
      "tags": ["utility", "process-management", "exec"],
      "complexity": "simple"
    },
    {
      "id": "class:examples/demo_service.cpp:DemoService",
      "type": "class",
      "name": "DemoService",
      "filePath": "examples/demo_service.cpp",
      "lineRange": [51, 165],
      "summary": "继承 BnDemoService 的服务端实现，覆写全部 AIDL 方法并统计事务次数；内部用互斥锁维护回调列表，并在每次调用时打印 binder 调用方的 pid/uid。",
      "tags": ["aidl-implementation", "binder-service", "service", "thread-safe"],
      "complexity": "complex",
      "languageNotes": "继承自 AIDL 生成的 Bn* 骨架类，事务计数用 std::atomic，回调列表用 std::mutex 保护——binder 线程池是多线程并发进入的。"
    },
    {
      "id": "function:examples/demo_service.cpp:registerCallback",
      "type": "function",
      "name": "registerCallback",
      "filePath": "examples/demo_service.cpp",
      "lineRange": [82, 91],
      "summary": "注册客户端传入的 IDemoCallback 远程回调对象，空指针时返回异常状态，成功后加入受锁保护的回调列表。",
      "tags": ["binder-service", "callback", "validation", "aidl-implementation"],
      "complexity": "simple"
    },
    {
      "id": "function:examples/demo_service.cpp:unregisterCallback",
      "type": "function",
      "name": "unregisterCallback",
      "filePath": "examples/demo_service.cpp",
      "lineRange": [93, 104],
      "summary": "按底层 binder 对象身份（IDemoCallback::asBinder）比对并移除已注册的回调，避免用代理指针直接比较造成误判。",
      "tags": ["binder-service", "callback", "aidl-implementation", "identity"],
      "complexity": "moderate",
      "languageNotes": "跨进程回调必须通过 asBinder() 取得的 IBinder 身份来比较，同一远端对象在本地可能对应不同的代理包装。"
    },
    {
      "id": "function:examples/demo_service.cpp:broadcast",
      "type": "function",
      "name": "broadcast",
      "filePath": "examples/demo_service.cpp",
      "lineRange": [106, 121],
      "summary": "在持锁期间复制回调列表快照，锁外逐个回调 onEvent 向所有已注册客户端反向发起 binder 事务，避免持锁调用远端造成死锁。",
      "tags": ["binder-service", "callback", "broadcast", "concurrency"],
      "complexity": "moderate",
      "languageNotes": "先拷贝快照再在锁外发起远程调用，是回调广播的经典防死锁写法。"
    },
    {
      "id": "function:examples/demo_service.cpp:openReport",
      "type": "function",
      "name": "openReport",
      "filePath": "examples/demo_service.cpp",
      "lineRange": [123, 142],
      "summary": "创建临时文件写入服务进程 pid 与事务计数，dup 出其 fd 并包装成 ParcelFileDescriptor 返回，演示 binder 的跨进程文件描述符传递。",
      "tags": ["binder-service", "file-descriptor", "aidl-implementation", "ipc"],
      "complexity": "moderate",
      "languageNotes": "binder 驱动会在事务中把 fd 翻译到目标进程的 fd 表；这里用 unique_fd 包装保证所有权转移不泄漏。"
    },
    {
      "id": "function:examples/demo_service.cpp:ensureServiceManager",
      "type": "function",
      "name": "ensureServiceManager",
      "filePath": "examples/demo_service.cpp",
      "lineRange": [193, 230],
      "summary": "检测 servicemanager 是否在运行，若没有则通过 demo::spawn 拉起一个，注册 atexit 与信号处理确保退出时清理，并轮询等待其就绪。",
      "tags": ["bootstrap", "process-management", "servicemanager", "resilience"],
      "complexity": "moderate"
    },
    {
      "id": "function:examples/demo_service.cpp:main",
      "type": "function",
      "name": "main",
      "filePath": "examples/demo_service.cpp",
      "lineRange": [234, 258],
      "summary": "程序入口：初始化 ProcessState 与线程池上限，构造 DemoService，确保 servicemanager 可用后以 \"demo.service\" 名注册，最后启动并加入 binder 线程池持续处理事务。",
      "tags": ["entry-point", "binder-service", "bootstrap", "ipc"],
      "complexity": "moderate"
    }
  ],
